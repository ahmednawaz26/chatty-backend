@baseUrl = http://localhost:5000

@urlPath = api/v1

###
POST {{baseUrl}}/{{urlPath}}/signup
Content-Type: application/json
Accept: application/json
withCredentials: true

{
  "username": "ahmed",
  "email": "ahmed@test.com",
  "password": "ahmed",
  "avatarColor": "#FF8822",
  "avatarImage": "data:image/jpeg;base64,"
}

###
POST {{baseUrl}}/{{urlPath}}/signin
Content-Type: application/json
Accept: application/json
withCredentials: true

{
  "username": "ahmed",
  "password": "newpass"
}

###
GET {{baseUrl}}/{{urlPath}}/signout
Content-Type: application/json
Accept: application/json
withCredentials: true

###
GET {{baseUrl}}/{{urlPath}}/currentuser
Content-Type: application/json
Accept: application/json
withCredentials: true

###
POST {{baseUrl}}/{{urlPath}}/forgot-password
Content-Type: application/json
Accept: application/json
withCredentials: true

{
  "email": "ahmed@test.com"
}

###
POST {{baseUrl}}/{{urlPath}}/reset-password/792e42022906939c93f0efcaca01a46a5d723283
Content-Type: application/json
Accept: application/json
withCredentials: true

{
  "password": "newpass",
